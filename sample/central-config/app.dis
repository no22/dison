// The entry module doubles as the composition root: it imports the
// services and declares the whole application's wiring in one place —
// including a constructor argument captured from a local constant.
//
// Static resolution (2.0) resolves this across files: app.dis gets an
// exported factory function for the bind expression (it references
// DB_URL, which only exists in this module), and the UserService
// getter in services.ts calls that factory directly. No shared
// registry, no @no22/dison runtime import — the generated project has
// zero runtime dependencies. Try it:
//
//   npx dison sample/central-config/services.dis sample/central-config/app.dis
//   npx tsx sample/central-config/app.ts
//
//   npx dison --explain sample/central-config/services.dis sample/central-config/app.dis

import { Repository, PostgresRepository, UserService } from "./services";

const DB_URL = "postgres://localhost/app";

bind Repository = PostgresRepository(DB_URL);

console.log(new UserService().lookup("42"));
