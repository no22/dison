// This module declares its own IRepository — unaware that
// admin-module.dis declares an unrelated interface with the exact
// same name. No tokens, no coordination between the two modules.
//
// Dison resolves this automatically: each interface declaration gets
// its own generated companion Symbol, so the two IRepository types are
// distinct keys at runtime and never collide across files. (Concrete
// classes are handled the same way, keyed by the class value itself.)
export interface IRepository {
  whoAmI(): string;
}

export class SqlUserRepository implements IRepository {
  whoAmI() {
    return "real user repository";
  }
}

class MockUserRepository implements IRepository {
  whoAmI() {
    return "mock user repository";
  }
}

export class UserService {
  injectable repo: IRepository = new SqlUserRepository();
}

configuration UseMockUserRepo {
  bind IRepository = MockUserRepository;
}
