// A second, completely unrelated module that happens to declare its
// own IRepository interface too. It never collides with
// user-module.dis's IRepository — Dison keys each declaration by its
// own companion Symbol, so no token or coordination is needed.
export interface IRepository {
  whoAmI(): string;
}

export class SqlAdminRepository implements IRepository {
  whoAmI() {
    return "real admin repository";
  }
}

class MockAdminRepository implements IRepository {
  whoAmI() {
    return "mock admin repository";
  }
}

export class AdminService {
  injectable repo: IRepository = new SqlAdminRepository();
}

configuration UseMockAdminRepo {
  bind IRepository = MockAdminRepository;
}
