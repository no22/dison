{
  "name": "@no22/dison",
  "version": "1.6.2",
  "type": "module",
  "description": "An experimental DSL that transpiles to TypeScript, with property injection built into the language itself.",
  "main": "./dist/core.js",
  "types": "./dist/core.d.ts",
  "bin": {
    "dison": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./runtime": {
      "types": "./dist/generated-runtime.d.ts",
      "default": "./dist/generated-runtime.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/no22/dison.git"
  },
  "homepage": "https://github.com/no22/dison#readme",
  "bugs": {
    "url": "https://github.com/no22/dison/issues"
  },
  "scripts": {
    "build": "rm -rf dist && tsx scripts/generate-runtime-module.ts && tsc && chmod +x dist/cli.js",
    "prepare": "npm run build",
    "test": "vitest run"
  },
  "keywords": [
    "dependency-injection",
    "dsl",
    "transpiler",
    "typescript"
  ],
  "author": "OHARA Hiroyuki",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
